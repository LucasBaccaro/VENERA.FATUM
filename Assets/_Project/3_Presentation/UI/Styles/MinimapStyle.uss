/* ═══════════════════════════════════════════════════════
   MINIMAP / RADAR
   ═══════════════════════════════════════════════════════ */

.minimap-container {
    width: 200px;
    height: 200px;
    overflow: visible; /* Let the frame show its full art */
    align-items: center;
    justify-content: center;
}

.minimap-texture {
    position: absolute;
    width: 170px;
    height: 170px;
    border-radius: 85px; /* Make the texture itself round */
    overflow: hidden;
    z-index: 10;
}

.minimap-frame {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url('project://database/Assets/_Project/5_Content/Resources/Panels/UI-Minimap.png');
    -unity-background-scale-mode: scale-to-fit;
    z-index: 20; /* Ensure frame is on top of texture */
    pointer-events: none;
}

.minimap-player-icon {
    position: absolute;
    width: 14px;
    height: 14px;
    background-color: rgb(0, 255, 255);
    border-radius: 7px;
    border-width: 2px;
    border-color: white;
    z-index: 30; /* On top of everything */
}

