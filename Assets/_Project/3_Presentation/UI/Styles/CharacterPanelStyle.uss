/* ═══════════════════════════════════════════════════════
   GENESIS - Character Panel Styles (MMO Scale)
   ═══════════════════════════════════════════════════════ */

.character-panel-window {
    position: absolute;
    width: 620px;
    height: 550px;
    background-image: url('project://database/Assets/_Project/5_Content/Resources/Panels/UI-GPW-CharacterPanel.png');
    -unity-background-scale-mode: stretch-to-fill;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    overflow: hidden;
}

/* ScrollView for right page stats */
.stats-scroll-view {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

/* Force hide all scrollers */
.stats-scroll-view Scroller,
.stats-scroll-view #unity-vertical-scroller,
.stats-scroll-view #unity-horizontal-scroller,
.stats-scroll-view #unity-slider {
    display: none;
    opacity: 0;
    width: 0;
    height: 0;
    visibility: hidden;
    position: absolute;
}

/* Page Containers */
.page-container {
    position: absolute;
    width: 50%;
    height: 100%;
}

.left-page {
    left: 0;
    padding: 35px 15px 20px 30px;
}

.right-page {
    right: 0;
    padding: 35px 25px 20px 20px;
}

/* Equipment Slots Layout */
.equipment-layout {
    position: relative;
    width: 100%;
    height: 100%;
}

/* Base Equipment Slot */
.char-item-slot {
    width: 52px;
    height: 52px;
    position: absolute;
    justify-content: center;
    align-items: center;
}

.char-item-slot-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url('project://database/Assets/_Project/5_Content/Resources/Panels/UI-Base_Slot.png');
    -unity-background-scale-mode: stretch-to-fill;
    display: none; /* Hidden by default if empty */
}

.char-item-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 46px;
    height: 46px;
    translate: -50% -50%;
    -unity-background-scale-mode: scale-to-fit;
    pointer-events: none;
    transition-property: scale;
    transition-duration: 0.1s;
}

.char-item-slot:hover .char-item-icon {
    scale: 1.1;
}

/* Slot Positions - Paper Doll Layout */
#HeadSlot { top: 10px; left: 105px; }

#ShouldersSlot { top: 80px; left: 35px; }
#ChestSlot { top: 80px; left: 105px; }
#HandsSlot { top: 80px; left: 175px; }

#LegsSlot { top: 150px; left: 35px; }
#BeltSlot { top: 150px; left: 105px; }
#BootsSlot { top: 150px; left: 175px; }

#Ring1Slot { top: 230px; left: 70px; }
#Ring2Slot { top: 230px; left: 140px; }

#MainHandSlot { top: 305px; left: 60px; }
#OffHandSlot { top: 305px; left: 148px; }

/* Stats Page Styles */
.stats-title {
    font-size: 14px;
    color: #5d4037;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 3px;
    margin-top: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(93, 64, 55, 0.3);
    padding-bottom: 3px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1px;
    padding: 2px 8px;
}

.stat-label {
    font-size: 12px;
    color: #5d4037;
    -unity-font-style: bold;
}

.stat-value {
    font-size: 12px;
    color: #2e7d32;
    -unity-font-style: bold;
}

/* Attribute title row with unspent points */
.attr-title-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.unspent-points-label {
    font-size: 11px;
    color: #b8860b;
    -unity-font-style: bold;
    margin-right: 6px;
}

/* Attribute + button */
.char-attr-plus-btn {
    width: 22px;
    height: 20px;
    font-size: 14px;
    color: #b8860b;
    background-color: rgba(184, 134, 11, 0.12);
    border-width: 1px;
    border-color: rgba(184, 134, 11, 0.35);
    border-radius: 3px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
    margin-left: 6px;
}

.char-attr-plus-btn:hover {
    background-color: rgba(184, 134, 11, 0.3);
    border-color: rgba(184, 134, 11, 0.7);
}

.char-attr-plus-btn:disabled {
    color: rgba(93, 64, 55, 0.3);
    background-color: transparent;
    border-color: rgba(93, 64, 55, 0.15);
}

/* Rarity Effects - Matching Inventory Style */
.rarity-common { -unity-background-image-tint-color: #ffffff; }
.rarity-uncommon { -unity-background-image-tint-color: #1eff00; }
.rarity-rare { -unity-background-image-tint-color: #0070dd; }
.rarity-epic { -unity-background-image-tint-color: #a335ee; }
.rarity-legendary { -unity-background-image-tint-color: #ff8000; }

.slot-highlight {
    /* No visual elements here to avoid unwanted borders */
}

.char-item-slot:hover {
    background-color: transparent;
}

/* Item Stats Styles */
.item-stats-container {
    flex-grow: 1;
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(93, 64, 55, 0.2);
}

.item-stats-container #unity-vertical-scroller,
.item-stats-container #unity-horizontal-scroller {
    width: 0;
    height: 0;
    display: none;
    visibility: hidden;
}

.item-stat-entry {
    margin-bottom: 4px;
}

.item-stat-name {
    font-size: 12px;
    color: #5d4037;
    -unity-font-style: bold;
}

.item-stat-values {
    font-size: 11px;
    color: #2e7d32;
    padding-left: 8px;
}
