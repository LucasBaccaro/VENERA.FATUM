.tooltip-main {
    position: absolute;
    width: 210px;
    background-color: rgba(20, 20, 20, 0.95);
    border-width: 2px;
    border-color: #555;
    border-radius: 4px;
    padding: 9px;
    color: #ddd;
    font-size: 11px;
    opacity: 0; /* Hidden by default */
    transition-property: opacity;
    transition-duration: 0.15s;
    -unity-font-definition: resource("Fonts/CrimsonText-Regular");
}

/* Header */
.tooltip-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 2px;
    white-space: normal;
}

.tooltip-type {
    font-size: 9px;
    color: #aaa;
    margin-bottom: 6px;
    -unity-font-style: italic;
}

.tooltip-required-level {
    font-size: 9px;
    color: rgb(255, 210, 0);
    -unity-font-style: italic;
    margin-top: 2px;
}

/* Stats Section */
.tooltip-stats-section {
    margin-top: 5px;
    margin-bottom: 5px;
}

.tooltip-armor {
    font-size: 12px;
    -unity-font-style: bold;
    color: #e0e0e0;
    margin-bottom: 3px;
}

.tooltip-primary-stats {
    font-size: 11px;
    color: #ffd700; /* Goldish for primary stats */
}

/* Substats Section */
.tooltip-substats-section {
    margin-top: 8px;
}

.tooltip-divider {
    height: 1px;
    background-color: #444;
    margin-bottom: 4px;
}

.tooltip-substats-list {
    font-size: 10px;
    color: #8da6b5; /* Blue-grey for magic props */
}

/* Description */
.tooltip-description {
    margin-top: 8px;
    font-size: 9px;
    color: #888;
    white-space: normal;
    -unity-font-style: italic;
}

/* Rarity Colors (Applied via code to Title) */
.rarity-common { color: #ffffff; }
.rarity-uncommon { color: #1eff00; }
.rarity-rare { color: #0070dd; }
.rarity-epic { color: #a335ee; }
.rarity-legendary { color: #ff8000; }
