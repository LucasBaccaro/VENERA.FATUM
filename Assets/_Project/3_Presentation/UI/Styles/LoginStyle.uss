.login-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
}

.login-panel {
    width: 400px;
    padding: 30px;
    background-color: rgba(20, 20, 30, 0.95);
    border-color: rgba(120, 90, 50, 0.8);
    border-width: 2px;
    border-radius: 8px;
    align-items: center;
}

.game-title {
    font-size: 36px;
    color: rgb(220, 180, 100);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    margin-bottom: 24px;
    letter-spacing: 4px;
}

.name-hint {
    font-size: 14px;
    color: rgb(180, 180, 180);
    margin-bottom: 6px;
    align-self: flex-start;
}

.name-input {
    width: 100%;
    height: 40px;
    font-size: 18px;
    margin-bottom: 20px;
    background-color: rgba(10, 10, 15, 0.9);
    border-color: rgba(100, 100, 120, 0.6);
    border-width: 1px;
    border-radius: 4px;
    color: rgb(240, 240, 240);
    padding: 4px 8px;
}

.name-input > #unity-text-input {
    background-color: rgba(10, 10, 15, 0.9);
    border-width: 0;
    color: rgb(240, 240, 240);
    padding: 4px 8px;
    --unity-cursor-color: rgb(220, 180, 100);
}

.name-input > #unity-text-input > TextElement {
    color: rgb(240, 240, 240);
    font-size: 18px;
}

.name-input > #unity-text-input > .unity-text-element--placeholder {
    color: rgba(180, 180, 180, 0.5);
}

.name-input:focus {
    border-color: rgba(220, 180, 100, 0.8);
}

.name-input:focus > #unity-text-input {
    border-color: rgba(220, 180, 100, 0.8);
}

.class-hint {
    font-size: 14px;
    color: rgb(180, 180, 180);
    margin-bottom: 8px;
    align-self: flex-start;
}

.class-button-row {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    margin-bottom: 24px;
}

.class-button {
    width: 48%;
    height: 50px;
    font-size: 18px;
    -unity-font-style: bold;
    border-width: 2px;
    border-radius: 6px;
    transition-duration: 0.15s;
}

.class-button--selected {
    background-color: rgba(60, 45, 20, 0.9);
    border-color: rgba(220, 180, 100, 0.9);
    color: rgb(220, 180, 100);
}

.class-button--unselected {
    background-color: rgba(40, 40, 55, 0.9);
    border-color: rgba(80, 80, 100, 0.6);
    color: rgb(180, 180, 180);
}

.class-button--unselected:hover {
    background-color: rgba(60, 60, 80, 0.9);
    border-color: rgba(120, 120, 150, 0.8);
}

.connect-button {
    width: 100%;
    height: 50px;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: rgba(60, 45, 20, 0.9);
    border-color: rgba(220, 180, 100, 0.8);
    border-width: 2px;
    border-radius: 6px;
    color: rgb(220, 180, 100);
    margin-bottom: 12px;
    transition-duration: 0.15s;
}

.connect-button:hover {
    background-color: rgba(80, 60, 25, 0.95);
    border-color: rgba(255, 210, 120, 1);
}

.status-label {
    font-size: 14px;
    color: rgb(255, 80, 80);
    min-height: 20px;
}
