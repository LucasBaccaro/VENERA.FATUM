/* ═══════════════════════════════════════════════════════
   GENESIS - Player Context Menu Styles
   ═══════════════════════════════════════════════════════ */

.context-menu-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

.context-menu-popup {
    position: absolute;
    width: 140px;
    padding: 8px;
    background-color: rgba(15, 12, 8, 0.95);
    border-width: 2px;
    border-color: rgba(200, 180, 120, 0.5);
    border-radius: 4px;
    display: none;
}

.context-menu-title {
    font-size: 12px;
    color: #e0bc7f;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 4px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    overflow: hidden;
    text-overflow: ellipsis;
}

.context-menu-divider {
    height: 1px;
    background-color: rgba(200, 180, 120, 0.3);
    margin-bottom: 4px;
}

.context-menu-button {
    height: 26px;
    background-color: rgba(60, 45, 20, 0.6);
    border-color: rgba(200, 180, 120, 0.3);
    border-width: 1px;
    border-radius: 3px;
    color: #e0bc7f;
    font-size: 12px;
    -unity-font-style: bold;
    margin-top: 2px;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.context-menu-button:hover {
    background-color: rgba(90, 70, 30, 0.9);
    border-color: #e0bc7f;
}
