/* ═══════════════════════════════════════════════════════
   GENESIS - Trade Window UI Styles
   ═══════════════════════════════════════════════════════ */

.trade-root {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.trade-window {
    position: absolute;
    width: 420px;
    opacity: 0.92;
    background-color: rgba(15, 12, 8, 0.95);
    border-width: 2px;
    border-color: rgba(200, 180, 120, 0.5);
    border-radius: 6px;
    padding: 12px;
    display: none;
}

.trade-title-bar {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 8px;
}

.window-title {
    font-size: 18px;
    color: #e0bc7f;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 1px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    flex-grow: 1;
}

.close-button {
    position: absolute;
    top: 0;
    right: 0;
    width: 24px;
    height: 24px;
    background-color: transparent;
    border-width: 0;
    color: #e0bc7f;
    font-size: 16px;
    -unity-font-style: bold;
}

.close-button:hover {
    color: #ff6666;
}

/* Trade Panels */
.trade-panels {
    flex-direction: row;
    justify-content: space-between;
}

.trade-panel {
    width: 48%;
    padding: 8px;
    background-color: rgba(30, 25, 18, 0.6);
    border-width: 1px;
    border-color: rgba(200, 180, 120, 0.25);
    border-radius: 4px;
}

.trade-divider {
    width: 2px;
    background-color: rgba(200, 180, 120, 0.3);
    margin-left: 4px;
    margin-right: 4px;
}

.panel-name {
    font-size: 13px;
    color: #e0bc7f;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 6px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* Trade Slots Grid */
.trade-slots {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.item-slot {
    width: 48px;
    height: 48px;
    margin: 3px;
    position: relative;
    justify-content: center;
    align-items: center;
}

.item-slot-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url('project://database/Assets/_Project/5_Content/Resources/Panels/UI-Base_Slot.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.item-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 38px;
    height: 38px;
    translate: -50% -50%;
    -unity-background-scale-mode: scale-to-fit;
    pointer-events: none;
    transition-property: scale;
    transition-duration: 0.1s;
}

.item-slot:hover .item-icon {
    scale: 1.15;
}

.item-quantity {
    position: absolute;
    bottom: 3px;
    right: 4px;
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px black;
    pointer-events: none;
}

/* Rarity Borders */
.rarity-common { -unity-background-image-tint-color: white; }
.rarity-uncommon { -unity-background-image-tint-color: #1eff00; }
.rarity-rare { -unity-background-image-tint-color: #0070dd; }
.rarity-epic { -unity-background-image-tint-color: #a335ee; }

/* Gold Row */
.gold-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding: 4px 6px;
    background-color: rgba(50, 40, 20, 0.5);
    border-radius: 3px;
}

.gold-label {
    font-size: 12px;
    color: #ffd700;
    -unity-font-style: bold;
    margin-right: 6px;
}

.gold-input {
    flex-grow: 1;
    height: 22px;
    font-size: 12px;
    color: #ffd700;
    background-color: rgba(20, 18, 12, 0.8);
    border-width: 1px;
    border-color: rgba(200, 180, 120, 0.3);
    border-radius: 2px;
}

.gold-input > .unity-text-field__input {
    color: #ffd700;
    background-color: transparent;
    border-width: 0;
    padding: 2px 4px;
}

.gold-value {
    font-size: 12px;
    color: #ffd700;
    -unity-font-style: bold;
    flex-grow: 1;
}

/* Status Label */
.status-label {
    font-size: 12px;
    color: #aaaaaa;
    -unity-text-align: upper-center;
    margin-top: 6px;
    margin-bottom: 4px;
    min-height: 16px;
}

/* Trade Buttons */
.trade-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.trade-button {
    height: 32px;
    min-width: 80px;
    margin: 0 6px;
    background-color: rgba(60, 45, 20, 0.8);
    border-color: #e0bc7f;
    border-width: 1px;
    border-radius: 3px;
    color: #e0bc7f;
    font-size: 13px;
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.trade-button:hover {
    background-color: rgba(90, 70, 30, 0.9);
}

.trade-button:disabled {
    opacity: 0.4;
    background-color: rgba(40, 35, 25, 0.6);
    border-color: rgba(200, 180, 120, 0.3);
    color: rgba(200, 180, 120, 0.4);
}

.lock-button.locked {
    background-color: rgba(30, 100, 30, 0.7);
    border-color: #66ff66;
    color: #66ff66;
}

.accept-button.accepted {
    background-color: rgba(30, 80, 120, 0.7);
    border-color: #66aaff;
    color: #66aaff;
}

/* Countdown Overlay */
.countdown-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 6px;
    display: none;
}

.countdown-label {
    font-size: 64px;
    color: #ffd700;
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.9);
}

/* Trade Request Popup */
.trade-request-popup {
    position: absolute;
    width: 280px;
    padding: 16px;
    background-color: rgba(15, 12, 8, 0.95);
    border-width: 2px;
    border-color: rgba(200, 180, 120, 0.5);
    border-radius: 6px;
    display: none;
    align-items: center;
}

.request-label {
    font-size: 14px;
    color: #e0bc7f;
    -unity-text-align: upper-center;
    margin-bottom: 12px;
    white-space: normal;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.request-buttons {
    flex-direction: row;
    justify-content: center;
}

.accept-request-button {
    background-color: rgba(30, 80, 30, 0.8);
    border-color: #66ff66;
    color: #66ff66;
}

.accept-request-button:hover {
    background-color: rgba(40, 110, 40, 0.9);
}

.decline-button {
    background-color: rgba(80, 30, 30, 0.8);
    border-color: #ff6666;
    color: #ff6666;
}

.decline-button:hover {
    background-color: rgba(110, 40, 40, 0.9);
}
