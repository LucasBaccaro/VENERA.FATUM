<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/3_Presentation/UI/Styles/MainStyle.uss?fileID=7433441132597879392&amp;guid=cf8f1d6e307ab41bb9434dc2ec321cee&amp;type=3#MainStyle"/>
    <ui:VisualElement name="HUD" picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; -unity-font-definition: resource(&quot;Fonts/CrimsonText-Regular&quot;);">
        <ui:VisualElement name="PlayerHUD" picking-mode="Ignore" class="player-hud-wrapper" style="width: 80%; height: 80%; align-items: stretch; display: flex;">
            <ui:VisualElement name="HUD_Base" picking-mode="Ignore" class="player-hud-base" style="width: 270px; height: 79px;">
                <ui:VisualElement name="BarsStack" style="position: absolute; left: -4px; top: 63px; width: 245px; height: 15px; justify-content: space-around;">
                    <ui:VisualElement name="NameGroup" class="bar-container-absolute" style="position: absolute; width: 300px; height: 28px; background-image: none; -unity-background-scale-mode: stretch-to-fill; display: flex;">
                        <ui:Label text="Player Name" name="PlayerName" class="player-name-label" style="top: -59px; left: 88px; height: 8px; width: 162px; font-size: 16px; letter-spacing: 3px; -unity-background-image-tint-color: rgb(255, 255, 255); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); color: rgb(63, 49, 32); text-shadow: 0 0 0 rgb(0, 0, 0);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="HealthGroup" class="bar-container-absolute" style="position: absolute; width: 178px; height: 19px; top: -43px; left: 64px;">
                        <ui:VisualElement name="HealthBar_Mask" class="bar-mask" style="width: 187px;">
                            <ui:VisualElement name="HealthBar_Fill" class="bar-fill-fixed hp-fill" style="width: 180px;"/>
                        </ui:VisualElement>
                        <ui:Label text="100 / 100" name="HealthText_Stylized" class="stylized-bar-text" style="top: 2px; left: 21px; width: 147px; height: 8px;"/>
                        <ui:VisualElement name="HP_Highlight" class="bar-highlight" style="opacity: 0.3;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ManaGroup" class="bar-container-absolute" style="position: absolute; width: 167px; height: 25px; top: -24px; left: 64px;">
                        <ui:VisualElement name="ManaBar_Mask" class="bar-mask" style="width: 268px; left: 3px;">
                            <ui:VisualElement name="ManaBar_Fill" class="bar-fill-fixed mp-fill" style="width: 230px; height: 19px; top: 5px; left: -52px;"/>
                        </ui:VisualElement>
                        <ui:Label text="50 / 50" name="ManaText_Stylized" class="stylized-bar-text" style="top: -2px; left: 10px;"/>
                        <ui:VisualElement name="MP_Highlight" class="bar-highlight" style="width: 172px; height: 16px; top: 6px; left: 5px; opacity: 0.3;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ExpGroup" class="bar-container-absolute" style="position: relative; width: 119px; height: 22px; opacity: 1; top: 1%;">
                        <ui:VisualElement name="ExpBar_Fill" class="bar-fill-fixed exp-fill" style="width: 227px; top: 2px; left: 4px; height: 13px;"/>
                        <ui:VisualElement name="ExpBar_Mask" class="bar-mask"/>
                        <ui:VisualElement name="EXP_Highlight" class="exp-highlight" style="top: 1px; left: 74px; width: 150px; opacity: 0.3;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="PortraitGroup" style="position: absolute; left: 0; top: 0; width: 140px; height: 140px; display: flex;">
                    <ui:VisualElement name="PortraitContainer" class="portrait-container" style="height: 97px; width: 91px; top: -5px; left: -14px;">
                        <ui:VisualElement name="PortraitIcon" class="portrait-icon"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ClassContainer" class="class-container" style="top: -9px; left: 47px; height: 41px; width: 37px;">
                        <ui:VisualElement name="ClassIcon" class="class-icon" style="width: 100%; height: 100%; opacity: 1; display: flex; position: absolute;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="LevelContainer" picking-mode="Ignore" class="level-container" style="background-image: resource(&quot;PlayerHUD/UI-PlayerHUD-LVL-Container&quot;); bottom: 34px; left: 11px; height: 40px; width: 40px;">
                        <ui:Label text="1" name="LevelLabel" class="level-label" style="font-size: 18px; width: 25px; -unity-text-align: upper-center; padding-right: 1px; margin-right: 2px; color: rgb(199, 173, 128); -unity-text-outline-color: rgb(43, 29, 11);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="GoldContainer" picking-mode="Ignore" style="position: absolute; bottom: 11px; right: -19px; flex-direction: row; align-items: center;">
                    <ui:Label text="0" name="GoldLabel" style="color: rgb(255, 215, 0); font-size: 16px; -unity-font-style: bold; position: absolute; top: 5px; left: -228px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="NotificationContainer" picking-mode="Ignore" style="position: absolute; top: 25%; left: 0; width: 100%; height: 50px; align-items: center; justify-content: center; display: flex; pointer-events: none;">
            <ui:Label text="Error Message" name="NotificationLabel" picking-mode="Ignore" style="font-size: 24px; color: rgb(255, 69, 69); -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); opacity: 0; transition-property: opacity; transition-duration: 0.3s;"/>
        </ui:VisualElement>
        <ui:VisualElement name="TargetFrame" picking-mode="Ignore" class="target-frame-container" style="position: absolute; top: 15px; left: 50%; width: 280px; translate: -50% 0; height: 94px; display: flex;">
            <ui:Label text="Target Name" name="TargetName" class="target-name-label"/>
            <ui:VisualElement name="TargetHeader" class="target-header"/>
            <ui:VisualElement name="TargetBody" class="target-body">
                <ui:VisualElement name="TargetHealthGroup">
                    <ui:ProgressBar value="100" name="TargetHealth" high-value="100" class="target-health-bar"/>
                    <ui:Label text="1000 / 1000" name="TargetHealthText" class="target-health-text" style="font-size: 8px; -unity-text-align: middle-center;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ProgressBar value="100" name="TargetMana" high-value="100" class="target-mana-bar" style="height: 21px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="CastGroup" picking-mode="Ignore" class="cast-group" style="display: flex; bottom: 156px; left: 50%; width: 450px; height: 50px; translate: -50% 0;">
            <ui:VisualElement name="CastBar_Background" class="cast-bar-bg" style="width: 100%; height: 100%;"/>
            <ui:VisualElement name="CastBar_Fill_Mask" class="cast-bar-mask" style="width: 429px; left: 9px; top: 9px;">
                <ui:VisualElement name="CastBar_Fill" class="cast-bar-fill" style="width: 425px; left: 3px; top: 1px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="CastBar_Highlight" class="cast-bar-highlight" style="width: 401px; left: 33px; top: 5px; height: 38px;"/>
            <ui:VisualElement name="CastBar_TickContainer" picking-mode="Ignore" style="position: absolute; left: 3px; top: 12px; width: 425px; height: 25px; display: flex; flex-direction: row;"/>
            <ui:VisualElement name="CastBar_TickRate" class="cast-bar-tick" style="display: none;"/>
            <ui:VisualElement name="CastBar_TopFrame" class="cast-bar-frame" style="height: 100%; width: 100%; top: 0; left: 0;"/>
            <ui:Label text="Spell Name" name="CastAbilityLabel" class="cast-ability-label" style="top: 6px; left: 23px; font-size: 16px;"/>
            <ui:Label text="0.0" name="CastTimerLabel" class="cast-timer-label" style="top: 6px; right: 17px; font-size: 15px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="NameplateContainer" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%;"/>
    </ui:VisualElement>
</ui:UXML>
