<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="QuestTrackerRoot" picking-mode="Ignore" style="position: absolute; top: 180px; right: 20px; width: 280px; pointer-events: none;">
        <ui:VisualElement name="QuestTrackerPanel" style="background-color: rgba(0, 0, 0, 0.65); border-radius: 6px; padding: 10px 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0.12); display: none;">
            <ui:Label name="QuestTitle" text="Quest Name" style="font-size: 14px; -unity-font-style: bold; color: rgb(255, 220, 100); margin-bottom: 6px; white-space: normal;"/>
            <ui:VisualElement name="ObjectivesContainer" style="flex-direction: column;">
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
